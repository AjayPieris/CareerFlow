// This connects to your database
datasource db {
  provider = "postgresql"
}

// This generates the TypeScript client (so you have auto-completion)
generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id                   // Clerk user ID (e.g. "user_abc123")
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Job {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  userId    String   // Clerk user ID - matches User.id

  title     String
  company   String
  location  String
  status    String   @default("Applied")

  link      String?
  note      String?
}